{
  "name": "@ratmath/core",
  "version": "0.4.0",
  "description": "Exact integers, rational numbers, fractions, rational intervals and interval sets, and certified approximations",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "index.js",
    "index.d.ts",
    "src/"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:examples": "bash scripts/test-examples.sh",
    "test:pack": "npm pack --dry-run --cache ./tmp/npm-cache",
    "prepublishOnly": "bun test --coverage && npm run test:examples && npm run test:pack",
    "docs:build": "bash scripts/build-docs.sh"
  },
  "keywords": [
    "rational",
    "fraction",
    "arithmetic",
    "interval",
    "continued-fraction",
    "repeating-decimal",
    "certified-approximation",
    "uncertainty",
    "exact",
    "mathematics",
    "bigint"
  ],
  "author": "James Taylor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jostylr/ratmath-core.git"
  },
  "homepage": "https://jostylr.github.io/ratmath-core/",
  "bugs": {
    "url": "https://github.com/jostylr/ratmath-core/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "bun-types": "1.3.14"
  }
}

    "arithmetic",
    "interval",
    "continued-fraction",
    "repeating-decimal",
    "exact",
    "mathematics",
    "bigint"
  ],
  "author": "James Taylor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jostylr/ratmath-core.git"
  },
  "homepage": "https://jostylr.github.io/ratmath-core/",
  "bugs": {
    "url": "https://github.com/jostylr/ratmath-core/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
}
